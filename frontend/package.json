    "react-dom": "^19.2.6",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.14"
